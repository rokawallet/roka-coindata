# Copy to .env.local for development. In production set these in the Vercel project settings.
# Never commit real values. See docs/ENVIRONMENT.md for details on every variable.

NODE_ENV=development
# Public base URL of this deployment (used for the fallback logo URL)
APP_BASE_URL=http://localhost:3000

# --- Supabase (server-side only; the service-role key bypasses RLS) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_LOGO_BUCKET=coin-logos

# --- Security ---
# >= 32 random chars. Used to HMAC API keys and hash client IPs. Changing it invalidates all API keys.
API_KEY_PEPPER=replace-with-64-random-hex-characters-0000000000000000
# >= 24 random chars. Vercel Cron sends it as "Authorization: Bearer <value>".
CRON_SECRET=replace-with-random-secret-at-least-24-chars
# Comma-separated allowed browser origins for the public API, or * . Empty = no CORS. Admin never gets CORS.
CORS_ALLOWED_ORIGINS=

# --- CoinGecko (primary provider) ---
# public | demo | pro
COINGECKO_API_PLAN=demo
COINGECKO_API_KEY=
# Optional override of the plan's default base URL
COINGECKO_BASE_URL=
# Shared per-minute budget across ALL instances. Set to your plan's real limit or lower.
COINGECKO_MAX_REQUESTS_PER_MINUTE=10

# --- GeckoTerminal (secondary provider) ---
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_MAX_REQUESTS_PER_MINUTE=20
# Order in which providers are consulted
PROVIDER_ORDER=coingecko,geckoterminal
PROVIDER_TIMEOUT_MS=8000
PROVIDER_MAX_RETRIES=2

# --- Freshness (seconds) ---
FRESHNESS_VERIFIED_SECONDS=86400
FRESHNESS_ESTABLISHED_SECONDS=259200
FRESHNESS_DISCOVERED_SECONDS=1209600
REFRESH_FAILURE_BACKOFF_SECONDS=900
REFRESH_MAX_BACKOFF_SECONDS=86400
UNKNOWN_TOKEN_COOLDOWN_SECONDS=3600
UNKNOWN_TOKEN_MAX_COOLDOWN_SECONDS=604800
REFRESH_BATCH_SIZE=20
REFRESH_TIME_BUDGET_MS=45000

# Allow unauthenticated GETs of unknown tokens to trigger provider discovery
PUBLIC_DISCOVERY_ENABLED=true

# --- Rate limits (requests per minute) ---
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_SERVICE_PER_MINUTE=1200
RATE_LIMIT_DISCOVERY_PER_MINUTE=10
RATE_LIMIT_DISCOVERY_SERVICE_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=60
MAX_BODY_BYTES=32768

# --- Logos ---
LOGO_MAX_BYTES=1048576
LOGO_FETCH_TIMEOUT_MS=8000
